# marche-kit の環境固有の設定
#
# このファイルをコピーして .env を作り、実際の値を書いてください。
#
#     cp .env.example .env
#
# .env は .gitignore 済みです。**このリポジトリに実運用の値を含めないこと。**
#
# 値の届き方は2経路あります。
#
#   PHP        環境変数 MARCHE_* → core/php/secrets.php の順に探します。
#              レンタルサーバーでは環境変数を設定できないことが多いため、
#              tools/inject-env.py が .env から secrets.php を生成します。
#
#   エディタJS  ブラウザに配信されるため環境変数を読めません。
#              ソースにはプレースホルダ(__ADMIN_KEY__ など)だけを置き、
#              tools/inject-env.py が配置用のコピーに対して置換します。


# ── 管理キー ───────────────────────────────────────────────
# 運営が使う合言葉。次の3つを兼ねます。
#   - 出店者エディタ  /editor/?<この値>       運営向けUI(店舗選択・未設定一覧)を出す
#   - お知らせエディタ /editor/news/?<この値>  ページのアクセスキー
#   - put-json.php                          お知らせ書き込みの認証
#
# 注意: エディタJSに埋め込まれるため、Basic認証などで /editor/ を保護しない限り
# 閲覧者に見えます。put-json.php の認証はその範囲でしか効きません。
MARCHE_ADMIN_KEY=

# ── 更新通知のWebhook ─────────────────────────────────────
# 出店者情報・お知らせが保存されたときに投稿します。空ならスキップします。
# 本文は {"content": "..."} のJSONで送ります(Discord互換)。
MARCHE_WEBHOOK_URL=

# ── メール ────────────────────────────────────────────────
# 問い合わせフォーム(send.php)の通知先
MARCHE_NOTIFY_EMAIL=

# 出店者情報の更新(shop-upload.php)の通知先。空ならメール通知しません
MARCHE_SHOP_NOTIFY_EMAIL=

# 送信元(From)。SPFを通すため、自サーバーのドメインのアドレスを推奨します
MARCHE_SENDER_EMAIL=
