{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kwaka1208/marche-kit/schema/config.schema.json",
  "title": "サイト設定 (marche.config.json)",
  "description": "イベント1つ分の設定。サイト生成側とPHP側が同じこのファイルを読む。年度更新はこのファイルの修正でほぼ完結する。",
  "type": "object",
  "required": ["site", "days", "pricing"],
  "additionalProperties": true,
  "properties": {
    "site": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "サイト名" },
        "url": { "type": "string", "description": "公開URL。OGPと構造化データに使う" },
        "description": { "type": "string", "description": "サイトの説明(meta description)" },
        "social": {
          "type": "array",
          "description": "イベント公式SNSのリンク。テーマのスロット [data-marche-social] に、この配列の順で出力される。未定義・空のときは1件も出力せず、スロットごと隠される",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "プラットフォームID。クラス名 social-link--<id> と data-platform に出る。コアが名前を知らないIDも書ける(その場合は label で表記を与える)"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://",
                "description": "リンク先。http:// または https:// で始まるものだけ出力される"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "画面に出す表記。省略時はコアが持つ既定の名前(x なら X)。既定を持たないIDでは platform の値がそのまま出る"
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "description": "開催概要。テンプレートから参照する。項目はイベントごとに増やしてよい",
      "properties": {
        "year": { "type": "integer" },
        "venue": { "type": "string", "description": "会場名" },
        "hours": { "type": "string", "description": "開催時間" }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "description": "開催日。配列が1件のときは販売日のUIを出力しない(サイト・エディタとも)",
      "items": {
        "type": "object",
        "required": ["id", "date", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^day[0-9]+$",
            "description": "日のID。day1 / day2 … の連番。商品の saleDays から参照される"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "開催日 (YYYY-MM-DD)"
          },
          "label": { "type": "string", "minLength": 1, "description": "選択肢などで使う表記(例: 10月3日(土))" },
          "shortLabel": { "type": "string", "description": "カード上の短い表記(例: 3日(土))。省略時は label を使う" }
        }
      }
    },
    "pricing": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "description": "対価の表示方法。商品の price をどう見せるかを決める",
      "properties": {
        "mode": {
          "enum": ["currency", "ticket"],
          "description": "currency = 金額として表示 / ticket = チケット枚数として表示。両者の併用は非対応"
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string", "default": "円", "description": "単位の表記。price-unit 要素として出力される" },
            "position": { "enum": ["prefix", "suffix"], "default": "suffix", "description": "単位を数値の前に置くか後ろに置くか" },
            "grouping": { "type": "boolean", "default": true, "description": "3桁ごとの区切りを入れるか" },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 4, "default": 0, "description": "小数桁。円は0、ドルやユーロは2" }
          }
        },
        "ticket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string", "default": "枚", "description": "単位の表記" },
            "faceValue": { "type": "number", "description": "チケット1枚の額面。案内の表示にのみ使う" },
            "showFaceValue": { "type": "boolean", "default": false, "description": "「チケット1枚 300円」の注記を出すか" }
          }
        },
        "note": {
          "type": "string",
          "description": "対価の但し書き(例: 税込)。price-note 要素として出力される。空または未設定なら要素ごと出力しない"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "ticket" } }, "required": ["mode"] },
          "then": { "required": ["ticket"] }
        }
      ]
    },
    "locale": {
      "type": "string",
      "default": "ja",
      "description": "表示文言の辞書。ja と en を同梱。core/i18n/<locale>.json を読む"
    },
    "timezone": {
      "type": "string",
      "description": "日付の解釈と表示に使うタイムゾーン(例: Asia/Tokyo)。お知らせの日付整形と通知の日時に使う。省略時はサーバー/ブラウザの既定"
    },
    "items": {
      "type": "object",
      "required": ["display"],
      "additionalProperties": false,
      "description": "商品情報をどこまで掲載するか。未定義のときは none(掲載しない)として扱う",
      "properties": {
        "display": {
          "enum": ["none", "popup", "list"],
          "default": "none",
          "description": "none = どこにも出さない(既定) / popup = 店舗ポップアップの取り扱い一覧と、そこから開く商品ポップアップだけ / list = popup に加えて商品一覧のセクション(フィルタ・もっと見る)も出す。none と popup では、テーマに商品一覧のスロットがあっても埋めず、[data-marche-items-section] ごと隠す"
        }
      }
    },
    "itemCategories": {
      "type": "array",
      "description": "商品カテゴリの定義(出店者のカテゴリとは別物)。商品一覧のフィルタとエディタの選択肢に使う。未定義または空のときは、エディタに商品カテゴリの欄を出さない。items.display が list のときだけフィルタとして意味を持つ",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "カテゴリID。商品の category に入る値"
          },
          "label": { "type": "string", "minLength": 1, "description": "画面に出す表記" }
        }
      },
      "uniqueItems": true
    },
    "announcements": {
      "type": "object",
      "additionalProperties": false,
      "description": "お知らせセクションの設定",
      "properties": {
        "source": {
          "type": "string",
          "description": "お知らせJSONのパス。空文字にするとセクション自体を出力しない"
        },
        "visibleCount": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "最初から見せる件数。これを超える古いものは「過去のお知らせ」側に折りたたむ"
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "description": "問い合わせフォームの設定。すべて省略可。項目そのものは forms/<種別>.json 側にある",
      "properties": {
        "endpoint": {
          "type": "string",
          "default": "data/send.php",
          "description": "送信先。空文字にするとモックモード(送らずに内容を画面へ出す)になる"
        },
        "honeypot": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "default": "website",
          "description": "おとり欄の項目名。フォームの実項目と同じ名前にしないこと"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "送信に失敗したときの再試行回数。0で再試行しない"
        },
        "successUrl": {
          "type": "string",
          "default": "",
          "description": "送信後の遷移先。空なら同じページで完了表示に差し替える"
        }
      }
    }
  },
  "examples": [
    {
      "site": {
        "name": "◯◯マルシェ",
        "url": "https://example.com",
        "description": "...",
        "social": [
          { "platform": "x", "url": "https://x.com/example" },
          { "platform": "instagram", "url": "https://www.instagram.com/example/" },
          { "platform": "youtube", "url": "https://www.youtube.com/@example", "label": "公式チャンネル" }
        ]
      },
      "event": { "year": 2026, "venue": "中央公園", "hours": "10:00-17:00" },
      "days": [
        { "id": "day1", "date": "2026-10-03", "label": "10月3日(土)", "shortLabel": "3日(土)" },
        { "id": "day2", "date": "2026-10-04", "label": "10月4日(日)", "shortLabel": "4日(日)" }
      ],
      "pricing": { "mode": "currency", "currency": { "unit": "円", "position": "suffix", "grouping": true, "decimals": 0 }, "note": "税込" },
      "locale": "ja",
      "items": { "display": "list" },
      "itemCategories": [
        { "id": "beer", "label": "ビール" },
        { "id": "food", "label": "フード" },
        { "id": "other", "label": "その他" }
      ],
      "announcements": { "source": "data/news.json", "visibleCount": 3 }
    }
  ]
}
