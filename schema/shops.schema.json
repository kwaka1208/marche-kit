{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kwaka1208/marche-kit/schema/shops.schema.json",
  "title": "出店者ロスター (shops.json)",
  "description": "サイトに表示する出店者の一覧とカテゴリ定義。ここに載っている店だけが表示される。shop-data/ にフォルダがあってもロスターに無ければ表示されない。カテゴリの数と名前はイベントごとに自由に決められる。",
  "type": "object",
  "required": ["categories"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "カテゴリの定義。配列の順序がサイトでの表示順になる",
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "examples": [
    {
      "categories": [
        { "id": "breweries", "label": "ブルワリー", "variant": "feature", "shops": ["choryo-brewery"] },
        { "id": "foodstores", "label": "フード", "shops": ["yamato-tacos"] }
      ]
    }
  ],
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "label", "shops"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "カテゴリID。テーマ側のスロット data-marche-shops=\"<id>\" と対応し、カードに data-category=\"<id>\" として出力される"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "画面に出す見出し"
        },
        "variant": {
          "enum": ["standard", "compact", "feature"],
          "default": "standard",
          "description": "カードの見た目のバリエーション。shop-card--<variant> クラスとして出力される。テーマはカテゴリIDではなくこちらを見てスタイルを書くのが基本(そうすれば他イベントでも使い回せる)"
        },
        "shops": {
          "type": "array",
          "description": "このカテゴリに属する店舗IDの配列。順序は固定表示時(?kotei)の並び順",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "店舗ID。shop-data/ 配下のフォルダ名と一致すること"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
